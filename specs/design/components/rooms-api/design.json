{
  "name": "rooms-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "rooms-api",
  "entrypoint": "deployment/service",
  "exposure": "intranet",
  "stories": [
    2,
    3,
    4,
    5,
    6,
    7,
    8,
    9
  ],
  "description": "Owns the fixed room catalog (seeded at deploy, read-only through this API) and every member's bookings. Lists rooms free for a requested date/time range and capacity, creates a booking after checking for an overlapping booking on the same room and for the group exceeding the room's capacity, lists the caller's own bookings, and cancels a booking only when the caller made it. Does not add, edit or remove rooms, does not handle recurring bookings, and does not send notifications.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "rooms-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "p72-teams-shared-c495b91a",
        "envBindings": {
          "dbname": "ROOMS_DB_DBNAME",
          "host": "ROOMS_DB_HOST",
          "password": "ROOMS_DB_PASSWORD",
          "port": "ROOMS_DB_PORT",
          "user": "ROOMS_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "p72-teams-shared-e61aa769",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
